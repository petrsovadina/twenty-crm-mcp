# ── Twenty CRM credentials ────────────────────────────────────
# API key: Settings → Playground → Generate API Key (workspace-scoped)
TWENTY_API_KEY=your_twenty_api_key_here
TWENTY_BASE_URL=https://crm.dev.reservio.com/rest

# ── MCP HTTP endpoint auth (required for Vercel deploy) ───────
# Generate: openssl rand -base64 32
# Clients must send Authorization: Bearer ${MCP_BEARER_TOKEN}
MCP_BEARER_TOKEN=

# ── Optional: disable write tools ─────────────────────────────
# When true, create_*/update_*/delete_* tools are not registered.
# Server then exposes only get_*, list_*, get_api_schema (read-only mode).
TWENTY_READ_ONLY=false
